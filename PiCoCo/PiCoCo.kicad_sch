	(title_block
		(title "PiCoCo - Pi Pico 2 to Tandy CoCo Cartridge")
		(date "2026-04-19")
		(rev "2.2")
		(company "Nathan Byrd")
		(comment 1 "LVC8T245 data bus + 3x LVC245A controls + 1G11 3-input /OE gate (E AND /CTS AND /SCS)")
		(comment 2 "GPIO: GP0-7=D0-D7, GP8-21=A0-A13, GP22=/R/W, GP26=OE_BUS, GP27=HALT_GATE, GP28=E; RUN from CoCo /RESET")
		(comment 3 "MVP: HDB-DOS ROM over /CTS + Becker $FF41/$FF42 over /SCS; firmware disambiguates by A13")
		(comment 4 "See docs/hardware-design.md and docs/firmware-architecture.md")
	)
