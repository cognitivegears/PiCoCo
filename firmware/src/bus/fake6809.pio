; Fake 6809 bus master for the Pico 2 build. Two words per cycle from the TX FIFO:
;   word 0: bits 0-13 = A0..A13, bit 14 = R/W (1 = read)         -> GP8..GP22 (out pins, 15)
;   word 1: bit 0 = selected (pull OE_BUS low while "E is high"), bits 1-8 = data sample delay
; Side-set pin = OE_BUS (GP26). One RX word per cycle: D0..D7 sampled during OE low (or 0 if unselected).
; At clkdiv 1.1 on a 150 MHz system clock: ~1.1 us per cycle, OE low ~ (67 +
; delay) PIO cycles (~490 ns + delay). Each former single-instruction [31]
; delay (32 cycles) is a pair of [15] instructions at the same side value
; (2x16 = 32 cycles): a 1-bit side-set only leaves 4 delay bits (max 15).
; push happens after OE_BUS has returned high (side 1, at `done`), not while
; it is still low: pushing mid-cycle let core0 start the next cycle (drive
; new write data or flip OE) while core1 was still in the read branch of the
; cycle core1 just serviced, since gpio_oe_clr on the shared SIO OE_BUS
; register also released the write data core0 was driving.
.program fake6809_p2
.side_set 1
.wrap_target
    pull block          side 1
    out pins, 15        side 1        ; address + R/W valid (E low, Q about to rise)
    pull block          side 1 [15]   ; address setup time
    nop                 side 1 [15]
    out x, 1            side 1
    out y, 8            side 1
    jmp !x nosel        side 1
    nop                 side 0        ; OE_BUS low: E high and cart selected
dly:
    jmp y-- dly         side 0        ; delay+1 cycles
    in pins, 8          side 0        ; sample D0..D7 (what core1 drives on a read)
    nop                 side 0 [15]
    nop                 side 0 [15]
    nop                 side 0 [15]
    nop                 side 0 [15]   ; (the missing pair: the brief had push[31] + nop[31] here)
    jmp done            side 1        ; OE_BUS high: E falling
nosel:
    nop                 side 1 [15]
    nop                 side 1 [15]
    nop                 side 1 [15]
    nop                 side 1 [15]
    in null, 8          side 1
done:
    nop                 side 1 [15]   ; E low
    nop                 side 1 [15]
    push block          side 1        ; cycle over: core1 has released D0-7 before cycle() returns
.wrap

; Plus-W variant: drives GP8..GP30 (A0-A13, R/W, GP23 LED, CTS, SCS, E, Q,
; SLENB, A14, A15) from six words per cycle: four phase words (pin levels),
; one control word (bits 0-7 sample delay), and a fifth phase word that drops
; E before the push, so core1 has released D0-7 by the time cycle() returns
; (see fake6809_p2's push-after-OE-high note above for why).
;   P0: address valid, E=0 Q=0    P1: Q=1    P2: E=1 (sample after delay)
;   P3: Q=0, E still 1            P4: E=0 Q=0 (cycle over)
; Bit k of a phase word is GP(8+k). No side-set: pins carry E/Q directly, so
; the [31] delays are plain instruction delays (5 bits), not side-set-limited.
.program fake6809_pw
.wrap_target
    pull block
    out pins, 23    [31]     ; P0: address valid, E=0 Q=0
    pull block
    out pins, 23    [31]     ; P1: Q=1
    pull block
    out pins, 23             ; P2: E=1
    pull block
    out y, 8                 ; sample delay
dly:
    jmp y-- dly
    in pins, 8
    pull block
    out pins, 23    [31]     ; P3: Q=0, E still 1
    pull block
    out pins, 23    [15]     ; P4: E=0 Q=0 — cycle over, core1 has released D0-7
    push block
.wrap

;Fast fake 6809 for the Pico 2 build (`bus selftest fast`): clkdiv 1, one TX
; word per cycle (fed by DMA), cycles back to back with no gap. Side-set =
; OE_BUS (GP26). Counts are clk_sys cycles; t=0 is the OE_BUS rise that ends
; the previous cycle, f=0 the OE_BUS fall.
;   TX word: [14:0]  A0..A13, R/W            -> GP8..GP22 (out pins, 15)
;            [16:15] e: OE_BUS high = 42 + 14*e (e=0 1.79 MHz, e=3 0.89 MHz)
;            [17]    1 = unselected: OE_BUS stays high for the "low" phase
;                    (that cycle is 1 clk longer)
;            [24:18] pre: D0-D7 sampled at f = pre+1
;            [31:25] post: OE_BUS low = pre + post + 3
;   RX word: [15:8] D0-D7 at f = pre+1, [7:0] D0-D7 at t = k+1 after the rise
;            that ends this cycle (release check).
; k (delay of `relchk`) and m (delay of the first pull) are patched at run
; time, k + m = 13, so the address still changes at t=17: setup 25 clk (+14*e).
.program fake6809_fast
.side_set 1
.wrap_target
    pull block      side 1 [10]   ; t=k+3 .. 16  (m = 13-k; 10 for k=3)
    out pins, 15    side 1        ; t=17: next address + R/W, 25 clk before the fall
    out x, 2        side 1        ; t=18
hiext:
    jmp x-- hiext   side 1 [13]   ; t=19..32 for e=0 (14 clk per pass)
    out y, 1        side 1        ; t=33: unselected bit
    out x, 7        side 1        ; t=34: pre
    jmp !y sel      side 1        ; t=35
    out y, 7        side 1 [5]    ; unselected: same phases, OE_BUS high
ulo:
    jmp x-- ulo     side 1
    in pins, 8      side 1
upost:
    jmp y-- upost   side 1
    jmp relchk      side 1
sel:
    out y, 7        side 1 [5]    ; t=36..41: post
lo:
    jmp x-- lo      side 0        ; f=0: OE_BUS falls; pre+1 clk
    in pins, 8      side 0        ; f=pre+1: the CPU's latch point
postl:
    jmp y-- postl   side 0        ; post+1 clk
public relchk:
    nop             side 1 [3]    ; OE_BUS rises: t=0..k
    in pins, 8      side 1        ; t=k+1: D0-D7 after the rise
    push noblock    side 1        ; t=k+2
.wrap

; Plus-W fast fake 6809 (`bus selftest fast` on a Plus-W): PIO1 (GPIO base 0),
; clkdiv 1, one TX word per cycle by DMA. Side-set = E (GP26).
; out pins GP8..GP25 (18): A0-A13, R/W, LED (0), /CTS, /SCS; set pins GP24-25.
;   TX word: [17:0] those pins, [24:18] pre, [31:25] post.
;   RX word: [15:8] D0-D7 at f = L+3+pre after E rose, [7:0] D0-D7 k+1 clk
;            after E fell (release check).
; t=0 is E falling, f=0 is E rising. E low = 42 + 14*e (t=17: address,
; R/W and selects change, 25 clk before E rises). E high = L + pre + post + 5.
; Patched per burst: `eset` (e), `erise` delay (L), `lset` (nop, or in a
; late-select burst `set pins, v` so the select falls at f = L+1), and the
; first pull / `relchk` delays (k + m = 13) as on the Pico 2.
.program fake6809_fast_pw
.side_set 1
.wrap_target
    pull block      side 0 [10]   ; t=k+3 .. 16
    out pins, 18    side 0        ; t=17: next address, R/W, selects
public eset:
    set x, 0        side 0        ; t=18: e
hiext:
    jmp x-- hiext   side 0 [13]   ; t=19..32 for e=0
    out x, 7        side 0        ; t=33: pre
    out y, 7        side 0 [7]    ; t=34..41: post
public erise:
    nop             side 1        ; f=0: E rises; delay L in a late-select burst
public lset:
    nop             side 1        ; f=L+1: late-select burst: the select falls here
lo:
    jmp x-- lo      side 1        ; pre+1 clk
    in pins, 8      side 1        ; f = L+3+pre: the CPU's latch point
postl:
    jmp y-- postl   side 1        ; post+1 clk
public relchk:
    nop             side 0 [3]    ; E falls: t=0..k
    in pins, 8      side 0        ; t=k+1: D0-D7 after E fell
    push noblock    side 0        ; t=k+2
.wrap

; Fake OE_BUS for a bare Plus-W (the carrier's U15 is not there): OE_BUS
; (GP40) low while E is high and /CTS or /SCS is low. Runs in the GPIO-base-16
; block. in_base GP24 with in_count 2 (/CTS, /SCS), jmp_pin GP26 (E),
; set_base GP40, y = 3. From E rising (select already low) to GP40 low:
; the wait, mov, jmp, set = 3-4 clk; a late select is polled every 3 clk.
.program fake_decode_pw
.pio_version 1
.wrap_target
top:
    wait 1 gpio 26          ; E high
poll:
    mov x, pins             ; x = /SCS:/CTS
    jmp x!=y hit            ; a select is low
    jmp pin poll            ; E still high: keep looking (late select)
.wrap
hit:
    set pins, 0             ; OE_BUS low
    wait 0 gpio 26          ; E falls
    set pins, 1             ; OE_BUS high
    jmp top

; Decode-delay probe (same block): one 16-bit sample of GP25..GP40 per clk,
; two per RX word (bit 0 /SCS, bit 1 E, bit 15 OE_BUS), drained by DMA.
.program decode_probe_pw
.pio_version 1
.wrap_target
    in pins, 16
.wrap

; Write data for `bus selftest fast` (bare module): D0-D7 belong to PIO0, the
; engine's block, so the fake 6809 in PIO1 cannot drive them. This test-only
; SM, loaded into PIO0 for one burst, drives each write cycle's data from its
; TX FIFO (one byte per write, by DMA), as the CoCo would; reads are left to
; the engine. out pins GP0 x8, jmp_pin R/W (GP22).
; Pico 2: a selected cycle is OE_BUS (GP26) low.
.program fake_wdata_p2
.pio_version 1
.wrap_target
    wait 0 gpio 26          ; a selected cycle
    jmp pin rd              ; R/W high: a read, the engine's
    pull block              ; this write's data
    out pins, 8
    mov pindirs, ~null
    wait 1 gpio 26          ; cycle over
    mov pins, null [1]      ; RP2350-E9: drive low, then release
    mov pindirs, null
rd:
    wait 1 gpio 26
.wrap

; Plus-W: a cycle is E (GP26) high; every write is driven, selected or not.
.program fake_wdata_pw
.pio_version 1
.wrap_target
    wait 1 gpio 26          ; E high
    jmp pin rd
    pull block
    out pins, 8
    mov pindirs, ~null
    wait 0 gpio 26          ; E low
    mov pins, null [1]
    mov pindirs, null
rd:
    wait 0 gpio 26
.wrap
