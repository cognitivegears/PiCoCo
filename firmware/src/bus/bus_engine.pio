; Bus engine: serves cartridge reads with no CPU in the path. PIO0 (GPIO
; base 0). in_base = GP8 (A0), out_base = GP0 (D0, 8 pins), jmp_pin = GP22
; (R/W). Y = &bus_mem >> 17 (the 128 KB-aligned table block), X = bank; both
; loaded by core0 while the SM is stopped (bus_engine.c, engine_start), X
; again by bus_engine_set_bank: one exec'd `set x`, anywhere in the program.
;
; Per read: the SM pushes the address of the table byte; DMA A moves it into
; DMA B's READ_ADDR_TRIG; DMA B copies that one byte into the TX FIFO.
;
; Cycle start (`trig`) and the two end-of-cycle waits (`wend`, `rend`) are
; patched per board at load (bus_engine.c):
;   Pico 2:  as assembled: OE_BUS (GP26) itself.
;   Plus-W:  trig `wait 1 irq 0`, ends `wait 1 irq 2`, both raised in this block
;            by bus_sel_pw, which watches OE_BUS (GP40) from a GPIO-base-16 PIO.
;
; Nothing more may go between the start wait and `push`, or between `pull`
; and `mov pindirs`: each instruction there costs 1 clk of read latency. The
; one there, `in x, 3`, is the bank, read at the last moment so a bank switch
; never has to touch the program counter (it costs every read 1 clk).

.program bus_read
.pio_version 1
.wrap_target
public top:
    mov isr, y              ; y = &bus_mem >> 17 (constant while running)
public trig:
    wait 0 gpio 26          ; Pico 2 as assembled; Plus-W: patched to `wait 1 irq 0`
    jmp pin rd              ; R/W high = CoCo read
public wend:
    wait 1 gpio 26          ; a write: never driven. Plus-W: `wait 1 irq 2`
    jmp top
rd:
    in x, 3                 ; x = bank, as it is now
    in pins, 14             ; isr = &bus_mem[x][A13..A0]
    push noblock
public wbyte:
    pull block              ; the byte, from DMA B (bus_engine_tick: stuck here = stalled)
    out pins, 8
    mov pindirs, ~null      ; drive only once the byte is in the latch
public rend:
    wait 1 gpio 26          ; end of the cycle. Plus-W: `wait 1 irq 2`
    mov pins, null [1]      ; RP2350-E9: drive low two clk...
    mov pindirs, null       ; ...then release
.wrap

; Event SM: one word per selected cycle, at its end, reads and writes alike.
; PIO0, in_base GP0 with in_count 23, so one `mov isr, pins` is D0-D7, A0-A13
; and R/W, and bits 23-31 read 0 (bus.h: BUS_EV_NONE can never be pushed).
; While the cycle lasts it keeps the last sample taken while the cycle was
; still on (x); a sample that finds the cycle over may be from after its end
; and is dropped. DMA C drains the RX FIFO (joined, 8 deep) into bus_events.
; It runs whether or not the read path drives (bus drive off), and is never
; restarted, so DMA C's position and core1's ring index stay in step.
; Pico 2: jmp_pin = OE_BUS (GP26).
.program bus_event_p2
.pio_version 1
.wrap_target
    wait 1 gpio 26          ; between cycles
    wait 0 gpio 26          ; a selected cycle
smp:
    mov isr, pins
    jmp pin done            ; OE_BUS high: over; this sample may be from after the end
    mov x, isr              ; a sample taken while the cycle was still on
    jmp smp
done:
    mov isr, x
    push noblock
.wrap

; Plus-W: jmp_pin = E (GP26); flag 1 from bus_sel_pw starts it.
.program bus_event_pw
.pio_version 1
.wrap_target
    wait 1 irq 1
smp:
    mov isr, pins
    jmp pin keep            ; E still high
    jmp done
keep:
    mov x, isr
    jmp smp
done:
    mov isr, x
    push noblock
.wrap

; Select helper (Plus-W): runs in a PIO block with GPIO base 16 (the one the
; cyw43 driver also uses), watches the board's OE_BUS on GP40 and raises the
; read SM's flags in PIO0 across blocks (`next` wraps from PIO2 to PIO0).
; Flag 1 starts the event SM (bus_event_pw). With bus drive off the helper
; runs alone, for the event SM; flags 0 and 2 then pile up unread and
; engine_start clears them.
.program bus_sel_pw
.pio_version 1
.wrap_target
    wait 1 gpio 40          ; starts here: a start while OE_BUS is low skips that cycle
    wait 0 gpio 40          ; OE_BUS low: selected and E high
    irq next set 0          ; read SM: cycle start
    irq next set 1          ; event SM
    wait 1 gpio 40          ; OE_BUS high: cycle over
    irq next set 2          ; read SM: release
.wrap
