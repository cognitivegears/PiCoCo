# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
*.log

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv
#auto_saved_files#
*.lck

# VS Code local history
.history/

# Analysis / exploration output
*_analysis.json

# Python
__pycache__/
*.pyc

# superpowers worktrees + scratch
.worktrees/
.superpowers/
build*/

# HDB-DOS / DriveWire ROM images the user supplies (see firmware/README.md)
firmware/roms/

# fab/main: the zip and the module stencil are the deliverables; loose plots are regenerated by tools/gen_fab.sh
fab/main/*.g??
fab/main/*.gbr
fab/main/*.gbrjob
fab/main/*.drl
